# Copy to `.e` in the project root (that file is git-ignored). Spring Boot loads the `.e` of the
# working directory automatically at startup; values are read through the `${VAR:default}` placeholders
# in `application.yaml`. OS environment variables and command-line arguments still take precedence.
#
# 这份文件也可以完全不手写：环境里没有 DB_URL 时，服务会自行进入「配置引导模式」，
# 打开前端 /setup 页面按向导填写即可，配置写完自动重启进入正常模式。

# 配置引导（可选）
# 服务默认在「没有 DB_URL」时进入引导模式。要重新走一遍引导，把 SETUP_MODE 设为 true 后重启；
# 想反过来强制跳过引导（配置由外部编排托管），设为 false。
# SETUP_MODE=
# 引导页请求要带的口令；留空时每次启动随机生成并打印在启动横幅里。无人值守部署可在此固定。
# SETUP_TOKEN=
# 配置文件放在别处时，用环境变量 APP_ENV_FILE 指定绝对路径。注意不能写在这一行——
# 服务读这份文件之前得先知道它在哪。它同时决定引导写哪份、启动读哪份。

# PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/cartask
DB_USERNAME=postgres
DB_PASSWORD=

# Startup mock data (development only)
MOCK_DATA_ENABLED=false

# Administrator startup initialization
# Set ADMIN_INITIALIZER_ENABLED=true to create the configured administrator.
# Existing accounts are only updated when ADMIN_INITIALIZER_FORCE_WRITE=true.
ADMIN_INITIALIZER_ENABLED=false
ADMIN_INITIALIZER_USERNAME=admin
ADMIN_INITIALIZER_PASSWORD=
ADMIN_INITIALIZER_FORCE_WRITE=false

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional when Redis authentication is enabled.
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOW_CREDENTIALS=true

# Login rate limiting
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=15m

# JWT
JWT_ISSUER=carTask
JWT_AUDIENCE=carTask-api
JWT_ACTIVE_SIGNING_KEY_ID=local
# Both values must be Base64-encoded random 32-byte keys.
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY_LOCAL=
JWT_TTL=2h
JWT_CLOCK_SKEW=30s
JWT_STORAGE_ENCRYPTION_KEY=
JWT_STORAGE_ENCRYPTION_KEY_ID=local

# File storage
# FILE_STORAGE_ROOT defaults to the application working directory when empty.
FILE_STORAGE_ROOT=
# Required absolute HTTP(S) URL used to build download links.
FILE_BASE_URL=http://localhost:8080

# Keytop open platform
KEYTOP_BASE_URL=https://kp-open.keytop.cn/unite-api
KEYTOP_APP_ID=0
KEYTOP_PARK_ID=
KEYTOP_APP_SECRET=
KEYTOP_PLATE_SYNC_CRON=*/30 * * * * *
KEYTOP_PLATE_RECONCILE_CRON=0 0 * * * *
KEYTOP_PLATE_SYNC_BATCH_SIZE=20
KEYTOP_PLATE_SYNC_MAX_ATTEMPTS=8
KEYTOP_PLATE_SYNC_DEFAULT_VALID_FROM=
KEYTOP_PLATE_SYNC_DEFAULT_VALID_TO=2099-12-31T23:59:59
KEYTOP_PLATE_SYNC_OPERATOR_ID=1
KEYTOP_PLATE_SYNC_OPERATOR_NAME=carTask
KEYTOP_VERSION=1.0.0
KEYTOP_TIMEOUT=30s
# 同步任务 Keytop 请求启动间隔（当前任务固定读取的快照，0ms 表示不主动限速）
KEYTOP_SYNC_REQUEST_INTERVAL=200ms
KEYTOP_AREA_SYNC_CRON=0 0 2 * * *
# 车辆进出记录图片下载间隔（两次下载启动时间的最小间隔，0ms 表示不主动限速）
KEYTOP_CAR_CAP_INFO_PHOTO_DOWNLOAD_INTERVAL=200ms
# 车辆进出记录图片下载并行数（同时进行的下载任务数，1 到 16）
KEYTOP_CAR_CAP_INFO_PHOTO_DOWNLOAD_CONCURRENCY=4

# AMap (高德地图) IP location lookup
AMAP_API_KEY=
